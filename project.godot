; Engine configuration file.
; WalkInCovenant — Godot 4.7
;
; Every non-default value here exists for a documented reason. See docs/ART.md §5.4
; (pixel-perfect rendering) and docs/FEEL.md (movement, camera, touch controls).
; If you change one of these, change the docs in the same commit.

config_version=5

[application]

config/name="WalkInCovenant"
config/description="A Bible story RPG you walk through. Witness, not author: your choices shape your character, never the scriptural outcome."
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=true
boot_splash/bg_color=Color(0.078, 0.125, 0.165, 1)

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
I18n="*res://scripts/autoload/I18n.gd"
GameState="*res://scripts/autoload/GameState.gd"
AudioDirector="*res://scripts/autoload/AudioDirector.gd"

[display]

; ── Base viewport: 320×180 = 20 × 11.25 tiles at TILE=16 ──────────────
; Integer-scales to 1080p at exactly 6×. If 16px is not legible on a 6.1"
; phone at arm's length, drop to 288×162 (shows less world, bigger pixels).
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true

; canvas_items (not viewport) so Control/UI lay out at viewport size too.
window/stretch/mode="canvas_items"
; expand, not keep: fills 19.5:9 and 20:9 phones instead of letterboxing them.
; The player simply sees a little more world on tall displays.
window/stretch/aspect="expand"
; integer: whole-number upscale only. This is what stops pixel shimmer.
window/stretch/scale_mode="integer"

window/handheld/orientation="sensor_landscape"
window/handheld/allow_hidpi=true

[gui]

; A pixel font must not be anti-aliased or sub-positioned, or it goes soft.
theme/default_font_antialiasing=0
theme/default_font_subpixel_positioning=0

[input]

; Movement is 4-directional (see docs/ART.md §1). Each direction carries
; arrows + WASD + gamepad dpad + left stick, so keyboard, touch and pad all
; route through the same actions. NEVER call Input.is_key_pressed() in
; gameplay code — that is what makes a future console port possible.

