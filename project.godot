[internationalization]

; Chinese is the default; English is the toggle. This is Covenant's existing
; choice and it does not change — the author writes in Chinese and the first
; audiences are Chinese-speaking churches.
locale/fallback="zh"
; locale/translations is intentionally NOT set yet.
; Once `node tools/port-ui-strings.mjs` has produced data/ui_strings.csv, Godot
; will import it and generate ui_strings.en.translation / ui_strings.zh.translation.
; Then add:
;   locale/translations=PackedStringArray("res://data/ui_strings.en.translation", "res://data/ui_strings.zh.translation")
; Note chapter content does NOT go through TranslationServer — it stays as inline
; {en, zh} pairs inside data/chapters/*.json, so a line of dialogue always sits
; next to its translation. That matters when a pastor is reviewing. See CONTENT.md §6.

[rendering]

; Nearest filtering. Without this every sprite blurs on upscale.
textures/canvas_textures/default_texture_filter=0
; gl_compatibility is REQUIRED for web export and is the fastest path on
; mid-range Android. Forward+ would break the primary platform.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Kills sub-pixel jitter — the "shimmer" that makes pixel art look amateur.
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.078, 0.125, 0.165, 1)

; VRAM compression is decided at IMPORT time, not at export time. Godot's web
; exporter refuses a preset that asks for mobile compression while ETC2/ASTC
; import is off -- and it reports that failure with an empty reason string
; (has_valid_project_configuration never fills r_error), so it surfaces as a
; bare "Cannot export project ... due to configuration errors". Phones are the
; target platform here, so both formats are on by design: ETC2/ASTC for mobile
; browsers, S3TC/BPTC for the desktop browsers this gets tested on.
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
