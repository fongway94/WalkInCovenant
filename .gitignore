# ── Godot 4 ─────────────────────────────────────────────────────────────
# The imported-asset cache. Regenerated on every open; never commit it.
.godot/

# NOTE: *.import metadata files ARE committed — they hold import settings
# (nearest filtering, mipmaps off, etc.) and losing them silently re-blurs
# every sprite in the project.

# Android export build directory
/android/

# Exported builds and presets containing signing secrets.
# export_presets.cfg is committed only AFTER you strip credentials from it,
# or kept out entirely and documented in docs/ARCHITECTURE.md §9.
export.cfg
export_credentials.cfg
*.keystore
*.jks

# ── Third-party asset packs ─────────────────────────────────────────────
# Ninja Adventure is ~89 MB and is CC0 — anyone can download it. Vendoring
# it would bloat the repo and the Arena patchset for no benefit.
# assets/LICENSES.md IS committed: it is the provenance record.
assets/ninja-adventure/
assets/kenney/
assets/0x72/
assets/pixelfrog/
assets/_eval/          # scratch scenes from the ART.md §4 evaluation protocol

# Keep the provenance + credits even though the packs themselves are ignored.
!assets/LICENSES.md
!assets/**/CREDITS.md

# Review scratch: nearest-neighbour upscales used to judge art by eye.
# The SHIPPED art (art/tiles, art/characters, art/props) is committed, matching
# Covenant's convention of committing its generated assets.
art/_preview/

# ── Web export output ───────────────────────────────────────────────────
# Generated by tools/build-web.mjs; deployed to GitHub Pages by CI.
web/build/
www/

# ── Node (tools/ only — the game itself is Godot, not Node) ─────────────
node_modules/
npm-debug.log*

# ── Editors / OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
.vscode/
.idea/
*.swp

# Python bytecode (tools/ are run, not imported by the game)
__pycache__/
*.pyc
